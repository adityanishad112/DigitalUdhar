{
  "name": "digital-udhar",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Udhar — Scan. Take Udhaar. Pay Later. A verified digital-udhaar & QR payment network for everyday shops.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "seed": "npm run seed -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:reset": "npm run db:reset -w backend",
    "postinstall": "node scripts/ensure-npm-shim.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
